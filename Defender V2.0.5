@client.tree.command(
    name="gunban",
    description="Remove a global ban"
)
@app_commands.describe(
    user_id="Discord User ID"
)
async def gunban(
    interaction: discord.Interaction,
    user_id: str
):

    # Hub server only
    if interaction.guild is None or interaction.guild.id != HUB_SERVER_ID:

        await interaction.response.send_message(
            "❌ Global unbans can only be issued from the Main 416 Server.",
            ephemeral=True
        )

        return


    # Permission check
    if not can_admin(interaction.user):

        await interaction.response.send_message(
            "❌ No permission.",
            ephemeral=True
        )

        return


    await interaction.response.defer()


    conn = db()
    cur = conn.cursor()

    # Is the user globally banned?
    cur.execute(
        """
        SELECT reason
        FROM global_bans
        WHERE user_id=?
        """,
        (user_id,)
    )

    result = cur.fetchone()

    if not result:

        conn.close()

        await interaction.followup.send(
            "❌ This user is not globally banned."
        )

        return


    # Remove from database
    cur.execute(
        """
        DELETE FROM global_bans
        WHERE user_id=?
        """,
        (user_id,)
    )

    conn.commit()
    conn.close()


    await add_log(
        interaction.guild,
        user_id,
        "GLOBAL UNBAN",
        "Removed global ban",
        interaction.user.id
    )


    successful = 0
    failed = []


    for guild in client.guilds:

        try:

            await guild.unban(
                discord.Object(id=int(user_id)),
                reason="Defender Global Unban"
            )

            successful += 1

        except discord.NotFound:
            # User wasn't banned here
            pass

        except Exception as e:

            failed.append(guild.name)

            print(
                f"Gunban failed in {guild.name}: {e}"
            )


    await interaction.followup.send(

        f"✅ **Global unban complete**\n\n"

        f"🌐 **Successful servers:** {successful}\n"

        f"❌ **Failed servers:** "
        f"{', '.join(failed) if failed else 'None'}"

    )

