# ================= DATABASE =================


def db():
    return sqlite3.connect("defender.db")



def setup_database():

    conn = db()
    cur = conn.cursor()


    cur.execute("""
    CREATE TABLE IF NOT EXISTS global_bans (

        id INTEGER PRIMARY KEY AUTOINCREMENT,

        user_id TEXT UNIQUE,

        reason TEXT,

        banned_by TEXT,

        date TEXT
    )
    """)



    cur.execute("""
    CREATE TABLE IF NOT EXISTS servers (

        server_id TEXT PRIMARY KEY,

        name TEXT
    )
    """)



    cur.execute("""
    CREATE TABLE IF NOT EXISTS admins (

        id INTEGER PRIMARY KEY AUTOINCREMENT,

        user_id TEXT,

        role_id TEXT,

        permission TEXT
    )
    """)



    cur.execute("""
    CREATE TABLE IF NOT EXISTS logs (

        id INTEGER PRIMARY KEY AUTOINCREMENT,

        user_id TEXT,

        action TEXT,

        reason TEXT,

        moderator TEXT,

        guild TEXT,

        date TEXT
    )
    """)



    cur.execute("""
    CREATE TABLE IF NOT EXISTS log_channels (

        guild_id TEXT PRIMARY KEY,

        channel_id TEXT
    )
    """)

    # ================= CASE NOTES =================


    cur.execute("""
    CREATE TABLE IF NOT EXISTS case_notes (

    id INTEGER PRIMARY KEY AUTOINCREMENT,

    case_id INTEGER,

    author TEXT,

    note TEXT,

    date TEXT

    )
    """)

    conn.commit()
    conn.close()





# ================= PERMISSION LEVEL SYSTEM =================


PERMISSION_LEVELS = {
    "manager": 4,
    "superadmin": 3,
    "admin": 2,
    "mod": 1
}


def get_permission_level(member):

    permission = get_permission(member)

    return PERMISSION_LEVELS.get(permission, 0)


def can_mod(member):

    return get_permission_level(member) >= PERMISSION_LEVELS["mod"]


def can_admin(member):

    return get_permission_level(member) >= PERMISSION_LEVELS["admin"]


def can_superadmin(member):

    return get_permission_level(member) >= PERMISSION_LEVELS["superadmin"]


def can_manager(member):

    return get_permission_level(member) >= PERMISSION_LEVELS["manager"]



def get_permission(member):


    # Permanent Defender Manager

    if member.id == OWNER_ID:

        return "manager"



    permissions = []



    conn = db()

    cur = conn.cursor()



    # Check direct user permissions

    cur.execute(
        """
        SELECT permission
        FROM admins
        WHERE user_id=?
        """,
        (str(member.id),)
    )


    results = cur.fetchall()



    for result in results:

        permissions.append(
            result[0]
        )



    # Check ALL role permissions

    for role in member.roles:


        cur.execute(
            """
            SELECT permission
            FROM admins
            WHERE role_id=?
            """,
            (str(role.id),)
        )


        results = cur.fetchall()



        for result in results:

            permissions.append(
                result[0]
            )



    conn.close()



    # No Defender permissions

    if not permissions:

        return None



    # Return highest permission

    highest = None

    highest_level = 0



    for permission in permissions:


        level = PERMISSION_LEVELS.get(
            permission,
            0
        )


        if level > highest_level:

            highest_level = level

            highest = permission



    return highest

# ================= MODERATION DM =================

async def send_mod_dm(
    user_id,
    action,
    reason,
    case_id,
    guild=None,
    global_action=False
):

    try:

        user = await client.fetch_user(
            int(user_id)
        )

        embed = discord.Embed(
            title="🌐 Defender Network Notice" if global_action else "🛡️ Defender Moderation Notice",
            colour=discord.Colour.red()
        )

        # Summary
        if global_action:

            embed.description = (
                "You have been **globally banned** across all **416-related servers** "
                "protected by Defender. The reason for this action is provided below."
            )

        else:

            if action == "Kick":

                embed.description = (
                    f"You have been **kicked** from **{guild.name if guild else 'this server'}**. "
                    "The reason for this action is provided below."
                )

            elif action == "Ban":

                embed.description = (
                    f"You have been **banned** from **{guild.name if guild else 'this server'}**. "
                    "The reason for this action is provided below."
                )

            else:

                embed.description = (
                    f"A moderation action has been taken against you in "
                    f"**{guild.name if guild else 'this server'}**."
                )

        if global_action:

            embed.add_field(
                name="Action",
                value=action,
                inline=False
            )

        else:

            embed.add_field(
                name="Server",
                value=guild.name if guild else "Unknown",
                inline=False
            )

            embed.add_field(
                name="Action",
                value=action,
                inline=True
            )

        embed.add_field(
            name="Reason",
            value=reason,
            inline=False
        )

        embed.add_field(
            name="Case ID",
            value=f"#{case_id}",
            inline=True
        )

        # Appeal information (Ban / Global Ban only)
        if action in ["Ban", "Global Ban"]:

            embed.set_footer(
                text="If you believe this was a mistake, please appeal at discord.gg/9trYue97N4"
            )

        await user.send(
            embed=embed
        )

    except discord.Forbidden:

        print(
            f"⚠️ Could not DM user {user_id} (DMs disabled)"
        )

    except Exception as e:

        print(
            f"⚠️ Failed to send moderation DM: {e}"
        )

# ================= BAN PROTECTION =================

def ban_protection(
    guild,
    user_id
):

    user_id = int(user_id)

    # Protect Defender Manager
    if user_id == OWNER_ID:

        return False, "User is the Defender Manager."

    # Protect Defender staff assigned directly by user ID
    conn = db()
    cur = conn.cursor()

    cur.execute(
        """
        SELECT permission
        FROM admins
        WHERE user_id=?
        """,
        (str(user_id),)
    )

    result = cur.fetchone()

    conn.close()

    if result:

        permission = result[0]

        return False, f"User is a Defender {permission}."

    # Check if the user is in this server
    member = guild.get_member(user_id)

    if member is None:

        return True, None

    # Protect server owner
    if member.id == guild.owner_id:

        return False, "User is the server owner."

    # Protect Discord administrators
    if member.guild_permissions.administrator:

        return False, "User has Discord Administrator permissions."

    # Protect Defender staff via roles
    permission = get_permission(member)

    if permission:

        return False, f"User is a Defender {permission}."

    return True, None

# ================= LOGGING =================

async def add_log(
    guild,
    user_id,
    action,
    reason,
    moderator
):

    print("ADD_LOG TRIGGERED:", action)

    conn = db()
    cur = conn.cursor()

    cur.execute(
        """
        INSERT INTO logs
        (
        user_id,
        action,
        reason,
        moderator,
        guild,
        date
        )
        VALUES (?,?,?,?,?,?)
        """,
        (
            str(user_id),
            action,
            reason,
            str(moderator),
            guild.name if guild else "Global",
            datetime.now().strftime("%d/%m/%Y %H:%M:%S")
        )
    )

    case_id = cur.lastrowid

    conn.commit()
    conn.close()

    # ================= LOCAL SERVER LOG =================

    channel = None

    if guild is not None:

        conn = db()
        cur = conn.cursor()

        cur.execute(
            """
            SELECT channel_id
            FROM log_channels
            WHERE guild_id=?
            """,
            (str(guild.id),)
        )

        result = cur.fetchone()

        conn.close()

        if result:

            channel = guild.get_channel(
                int(result[0])
            )

    embed = discord.Embed(
        title=f"🛡️ Defender | {action}",
        colour=discord.Colour.red(),
        timestamp=datetime.now()
    )

    embed.add_field(
        name="Case ID",
        value=f"#{case_id}",
        inline=True
    )

    embed.add_field(
        name="User",
        value=f"<@{user_id}> (`{user_id}`)",
        inline=False
    )

    embed.add_field(
        name="Moderator",
        value=f"<@{moderator}>",
        inline=True
    )

    embed.add_field(
        name="Reason",
        value=reason,
        inline=False
    )

    embed.add_field(
        name="Server",
        value=guild.name if guild else "Global",
        inline=True
    )

    if channel:

        await channel.send(
            embed=embed
        )

    # ================= HUB GLOBAL LOG =================

    # Only send external logs for branch servers
    if guild and guild.id != HUB_SERVER_ID:

        hub = client.get_guild(HUB_SERVER_ID)

        if hub:

            global_channel = hub.get_channel(
                GLOBAL_LOG_CHANNEL_ID
            )


            if global_channel:

                global_embed = discord.Embed(
                    title=f"🌐 Defender Network | {action}",
                    colour=discord.Colour.red(),
                    timestamp=datetime.now()
                )


                global_embed.add_field(
                    name="Case ID",
                    value=f"#{case_id}",
                    inline=True
                )


                global_embed.add_field(
                    name="User",
                    value=f"<@{user_id}> (`{user_id}`)",
                    inline=False
                )


                global_embed.add_field(
                    name="Moderator",
                    value=f"<@{moderator}>",
                    inline=True
                )


                global_embed.add_field(
                    name="Server",
                    value=guild.name,
                    inline=True
                )


                global_embed.add_field(
                    name="Reason",
                    value=reason[:1024],
                    inline=False
                )


                await global_channel.send(
                    embed=global_embed
                )


    return case_id
    
# ================= CLIENT =================



class Defender(discord.Client):


    def __init__(self):

        super().__init__(
            intents=intents
        )


        self.tree = app_commands.CommandTree(
            self
        )




client = Defender()





async def update_status():

    conn = db()

    cur = conn.cursor()



    cur.execute(
        "SELECT COUNT(*) FROM servers"
    )


    amount = cur.fetchone()[0]


    conn.close()



    await client.change_presence(

        activity=discord.Game(

            name=f"🛡️ Defending {amount} servers..."

        )

    )






@client.event
async def on_ready():

    print(f"🛡️ Defender {VERSION}")

    print("🗄️ Loading database...")
    setup_database()
    print("✅ Database loaded")

    print("🔄 Syncing commands...")
    await client.tree.sync()
    print("✅ Commands synced")

    print("📡 Updating presence...")
    await update_status()
    print("✅ Presence updated")

    print(f"🌐 Connected to {len(client.guilds)} server{'s' if len(client.guilds) != 1 else ''}")

    print("📋 Server List:")
    for guild in sorted(client.guilds, key=lambda g: g.name.lower()):
        print(f"   • {guild.name} ({guild.id})")

    print(f"🛡️ Defender is online as {client.user}")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

