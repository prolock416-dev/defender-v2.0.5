# ================= GLOBAL BAN CONFIRMATION =================


class ConfirmGlobalBan(discord.ui.View):

    def __init__(self, original_user, user_id, reason):

        super().__init__(timeout=60)

        self.original_user = original_user
        self.user_id = user_id
        self.reason = reason



    @discord.ui.button(
        label="Confirm",
        style=discord.ButtonStyle.danger,
        emoji="🔨"
    )
    async def confirm(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):


        # Only the person who ran /gban can confirm

        if interaction.user.id != self.original_user.id:

            await interaction.response.send_message(
                "❌ Only the moderator who started this ban can confirm it.",
                ephemeral=True
            )

            return



        # Check if already banned

        conn = db()
        cur = conn.cursor()


        cur.execute(
            """
            SELECT reason
            FROM global_bans
            WHERE user_id=?
            """,
            (self.user_id,)
        )


        existing = cur.fetchone()


        if existing:

            conn.close()

            await interaction.response.edit_message(
                content=f"❌ User is already globally banned.\nReason: {existing[0]}",
                embed=None,
                view=None
            )

            return



        # Add global ban

        cur.execute(
            """
            INSERT INTO global_bans
            (
            user_id,
            reason,
            banned_by,
            date
            )
            VALUES (?,?,?,?)
            """,
            (
                self.user_id,
                self.reason,
                str(interaction.user.id),
                datetime.now().strftime("%d/%m/%Y %H:%M:%S")
            )
        )


        conn.commit()
        conn.close()



        # Add log

        case_id = await add_log(
            interaction.guild,
            self.user_id,
            "GLOBAL BAN",
            self.reason,
            interaction.user.id
        )



        # Send global ban DM

        await send_mod_dm(
            self.user_id,
            "Global Ban",
            self.reason,
            case_id,
            global_action=True
        )



        successful = 0
        failed = []



        # Get registered Defender servers

        conn = db()
        cur = conn.cursor()


        cur.execute(
            """
            SELECT server_id
            FROM servers
            """
        )


        servers = cur.fetchall()


        conn.close()



        for (server_id,) in servers:


            guild = client.get_guild(
                int(server_id)
            )


            if guild is None:

                failed.append(
                    f"Unknown server ({server_id})"
                )

                continue



            try:

                await guild.ban(
                    discord.Object(
                        id=int(self.user_id)
                    ),
                    reason=f"Defender Global Ban: {self.reason}"
                )


                successful += 1



            except Exception as e:

                failed.append(
                    f"{guild.name}: {e}"
                )



        embed = discord.Embed(
            title="✅ Global Ban Complete",
            colour=discord.Colour.red()
        )


        embed.add_field(
            name="User",
            value=f"<@{self.user_id}>",
            inline=False
        )


        embed.add_field(
            name="Reason",
            value=self.reason,
            inline=False
        )


        embed.add_field(
            name="Case ID",
            value=f"#{case_id}",
            inline=True
        )


        embed.add_field(
            name="Successful Servers",
            value=str(successful),
            inline=True
        )


        embed.add_field(
            name="Failed Servers",
            value=(
                "\n".join(failed)
                if failed
                else "None"
            ),
            inline=False
        )



        await interaction.response.edit_message(
            embed=embed,
            view=None
        )




    @discord.ui.button(
        label="Cancel",
        style=discord.ButtonStyle.secondary,
        emoji="❌"
    )
    async def cancel(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):


        if interaction.user.id != self.original_user.id:

            await interaction.response.send_message(
                "❌ Only the moderator who started this ban can cancel it.",
                ephemeral=True
            )

            return



        embed = discord.Embed(
            title="❌ Global Ban Cancelled",
            colour=discord.Colour.greyple()
        )


        await interaction.response.edit_message(
            embed=embed,
            view=None
        )

