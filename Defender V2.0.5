    # Check if already banned
    bans = [
        entry async for entry in interaction.guild.bans()
    ]

    if any(entry.user.id == int(user_id) for entry in bans):

        await interaction.response.send_message(
            "❌ This user is already banned from this server."
        )

        return


    # Staff protection
    allowed, message = ban_protection(
        interaction.guild,
        user_id
    )


    if not allowed:

        await interaction.response.send_message(
            f"❌ Cannot ban this user.\n{message}"
