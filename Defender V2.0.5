@client.tree.command(
    name="case",
    description="View a Defender moderation case"
)
@app_commands.describe(
    case_id="Case ID"
)
async def case(
    interaction: discord.Interaction,
    case_id: int
):


    if not can_mod(interaction.user):

        await interaction.response.send_message(
            "❌ No permission."
        )

        return



    conn = db()
    cur = conn.cursor()



    cur.execute(
        """
        SELECT
        user_id,
        action,
        reason,
        moderator,
        guild,
        date

        FROM logs

        WHERE id=?

        """,

        (case_id,)
    )


    result = cur.fetchone()



    if not result:

        conn.close()

        await interaction.response.send_message(
            "❌ Case not found."
        )

        return



    user_id, action, reason, moderator, guild, date = result



    cur.execute(
        """
        SELECT
        author,
