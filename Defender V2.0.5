@client.tree.command(
    name="syncbans",
    description="Apply all Defender global bans to this server"
)
async def syncbans(interaction):

    if not can_admin(interaction.user):

        await interaction.response.send_message(
            "❌ No permission."
        )

        return



    conn = db()
    cur = conn.cursor()



    cur.execute(
        """
        SELECT user_id, reason
        FROM global_bans
        """
    )


    bans = cur.fetchall()


    conn.close()



    await interaction.response.send_message(
        f"⏳ Syncing {len(bans)} global bans..."
    )



    successful = 0
    failed = []



    for user_id, reason in bans:


        allowed, message = ban_protection(
            interaction.guild,
            user_id
        )


        if not allowed:

            failed.append(
                f"{user_id} ({message})"
            )

            continue



        try:

            await interaction.guild.ban(

                discord.Object(id=int(user_id)),

                reason=f"Defender Global Ban: {reason}"

            )

            successful += 1



        except:

            failed.append(
                user_id
            )



    await interaction.followup.send(

        f"✅ Sync complete\n\n"

        f"**Banned:** {successful}\n"

        f"**Failed:** {', '.join(failed) if failed else 'None'}"

    )

