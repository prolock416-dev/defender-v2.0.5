    description="Kick a user from this server"
)
@app_commands.describe(
    user_id="Discord User ID",
    reason="Reason for kick"
)
async def kick(
    interaction: discord.Interaction,
    user_id: str,
    reason: str
):

    if not can_mod(interaction.user):

        await interaction.response.send_message(
            "❌ No permission."
        )

        return


    # Protect staff / important users
    allowed, message = ban_protection(
        interaction.guild,
        user_id
    )


    if not allowed:

        await interaction.response.send_message(
            f"❌ Cannot kick this user.\n{message}"
        )

        return


    try:

        member = interaction.guild.get_member(
            int(user_id)
        )


        if member is None:

            await interaction.response.send_message(
                "❌ User must be in this server to be kicked."
            )

            return


    except Exception as e:

        await interaction.response.send_message(
            f"❌ Failed to find user.\n`{e}`"
        )

        return



    # Create case log first
    case_id = await add_log(
        interaction.guild,
        user_id,
        "KICK",
        reason,
        interaction.user.id
    )


    # Send moderation DM
    await send_mod_dm(
        user_id,
        "Kick",
        reason,
        case_id,
        interaction.guild
    )



    try:

        await member.kick(
            reason=reason
        )


    except Exception as e:

        await interaction.response.send_message(
            f"❌ Failed to kick user.\n`{e}`"
        )

        return



    await interaction.response.send_message(
        f"✅ User kicked.\nCase ID: #{case_id}"
    )
    
