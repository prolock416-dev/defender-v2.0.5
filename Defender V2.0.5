# ================= SERVER MANAGEMENT =================


@client.tree.command(
    name="addserver",
    description="Register this server with Defender"
)
async def addserver(interaction: discord.Interaction):

    if not can_superadmin(interaction.user):

        await interaction.response.send_message(
            "❌ Superadmin permission required.",
            ephemeral=True
        )

        return


    conn = db()
    cur = conn.cursor()


    # Check if already registered
    cur.execute(
        """
        SELECT server_id
        FROM servers
        WHERE server_id=?
        """,
        (str(interaction.guild.id),)
    )

    if cur.fetchone():

        conn.close()

        await interaction.response.send_message(
            "❌ This server is already registered with Defender.",
            ephemeral=True
        )

        return


    # Register server
    cur.execute(
        """
        INSERT INTO servers
        VALUES (?,?)
        """,
        (
            str(interaction.guild.id),
            interaction.guild.name
        )
    )

    conn.commit()
    conn.close()

    await update_status()

    await add_log(
        interaction.guild,
        interaction.user.id,
        "SERVER ADDED",
        "Server registered with Defender",
        interaction.user.id
    )

    await interaction.response.send_message(
        f"✅ **{interaction.guild.name}** has been registered with Defender."
    )




@client.tree.command(
    name="removeserver",
    description="Remove this server from Defender"
)
async def removeserver(interaction: discord.Interaction):

    if not can_superadmin(interaction.user):

        await interaction.response.send_message(
            "❌ Superadmin permission required.",
            ephemeral=True
        )

        return


    conn = db()
    cur = conn.cursor()


    # Check if registered
    cur.execute(
        """
        SELECT server_id
        FROM servers
        WHERE server_id=?
        """,
        (str(interaction.guild.id),)
    )

    if not cur.fetchone():

        conn.close()

        await interaction.response.send_message(
            "❌ This server is not registered with Defender.",
            ephemeral=True
        )

        return


    # Remove server
    cur.execute(
        """
        DELETE FROM servers
        WHERE server_id=?
        """,
        (str(interaction.guild.id),)
    )

    conn.commit()
    conn.close()

    await update_status()

    await add_log(
        interaction.guild,
        interaction.user.id,
        "SERVER REMOVED",
        "Server removed from Defender",
        interaction.user.id
    )

    await interaction.response.send_message(
        f"✅ **{interaction.guild.name}** has been removed from Defender."
    )




