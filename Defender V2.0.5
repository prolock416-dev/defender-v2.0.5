    user_id: str,
    reason: str
):

    # Hub server only
    if interaction.guild is None or interaction.guild.id != HUB_SERVER_ID:

        await interaction.response.send_message(
            "❌ Global bans can only be issued from the Main 416 Server.",
            ephemeral=True
        )

        return


    # Permission check
    if not can_admin(interaction.user):

        await interaction.response.send_message(
            "❌ No permission.",
            ephemeral=True
        )

        return


    # Protect Defender staff / owners / admins
    allowed, message = ban_protection(
        interaction.guild,
        user_id
    )

    if not allowed:

        await interaction.response.send_message(
            f"❌ Cannot ban this user.\n{message}",
            ephemeral=True
        )

        return


    conn = db()
    cur = conn.cursor()

    # Already globally banned?
    cur.execute(
        """
        SELECT reason, date
        FROM global_bans
        WHERE user_id=?
        """,
        (user_id,)
    )

    existing = cur.fetchone()

    if existing:

        conn.close()

        await interaction.response.send_message(
            f"❌ This user is already globally banned.\n\n"
            f"**Reason:** {existing[0]}\n"
            f"**Date:** {existing[1]}",
            ephemeral=True
        )

        return


    # Count Defender servers
    cur.execute(
        """
        SELECT COUNT(*)
        FROM servers
        """
    )

    server_count = cur.fetchone()[0]

    conn.close()

    embed = discord.Embed(
        title="⚠ Confirm Global Ban",
        colour=discord.Colour.orange()
    )

    embed.add_field(
        name="User",
        value=f"<@{user_id}>\n`{user_id}`",
        inline=False
    )

    embed.add_field(
        name="Reason",
        value=reason,
        inline=False
    )

    embed.add_field(
        name="Servers affected",
        value=str(server_count),
        inline=False
    )

    embed.set_footer(
        text="Only the moderator who started this action can confirm it."
    )

    await interaction.response.send_message(
        embed=embed,
        view=ConfirmGlobalBan(
            interaction.user,
            user_id,
            reason
        )
    )


