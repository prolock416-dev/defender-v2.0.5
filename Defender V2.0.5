            discord.Object(id=int(user_id)),
            reason=reason
        )


    except Exception as e:

        await interaction.response.send_message(
            f"❌ Failed to ban user.\n`{e}`"
        )

        return



    # Create case log
    case_id = await add_log(
        interaction.guild,
