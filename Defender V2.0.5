@client.tree.command(
    name="list_admins",
    description="View Defender staff"
)
async def list_admins(interaction: discord.Interaction):

    conn = db()
    cur = conn.cursor()


    cur.execute(
        """
        SELECT user_id, role_id, permission
        FROM admins
        ORDER BY
            CASE permission
                WHEN 'manager' THEN 4
                WHEN 'superadmin' THEN 3
                WHEN 'admin' THEN 2
                WHEN 'mod' THEN 1
                ELSE 0
            END DESC
        """
    )


    admins = cur.fetchall()

    conn.close()



    embed = discord.Embed(
        title="🛡️ Defender Staff Directory",
        description="Current Defender permission holders",
        colour=discord.Colour.orange()
    )



    sections = {
        "superadmin": [],
        "admin": [],
        "mod": [],
        "manager": []
    }



    # Permanent Manager
    sections["manager"].append(
        f"<:prolock:1530711020534763731> <@{OWNER_ID}>"
    )



    # Database entries
    for user_id, role_id, permission in admins:

        target = None


        if user_id:

            target = f"👤 <@{user_id}>"


        elif role_id:

            target = f"📄 <@&{role_id}>"


        if permission in sections and target:

            sections[permission].append(target)



    # Build staff directory with spacing between ranks
    staff_text = ""


    for index, permission in enumerate([
        "superadmin",
        "admin",
        "mod"
    ]):

        staff_text += (
            f"{PERMISSION_DISPLAY[permission]}\n"
        )


        if sections[permission]:

            staff_text += (
                "\n".join(sections[permission])
            )

        else:

            staff_text += "*None*"



        # Space before next rank
        if index < 2:

            staff_text += "\n\n"



    # Divider between staff and manager

    staff_text += (
        "\n\n━━━━━━━━━━━━━━\n\n"
    )



    # Defender Manager

    staff_text += (
        f"{PERMISSION_DISPLAY['manager']}\n"
    )


    if sections["manager"]:

        staff_text += (
            "\n".join(sections["manager"])
        )

    else:

        staff_text += "*None*"



    embed.add_field(

        name="\u200b",

        value=staff_text,

        inline=False

    )

    embed.set_footer(
        text=f"🛡️ Defender {VERSION}"
    )

    await interaction.response.send_message(

        embed=embed

    )
